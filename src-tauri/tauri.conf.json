{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MacToWindows",
  "version": "0.1.1",
  "identifier": "com.mactowindows.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MacToWindows",
        "width": 1040,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "visible": true,
        "resizable": true
      }
    ],
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/16x16.png",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/1024x1024.png"
    ],
    "resources": ["../ui"],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
